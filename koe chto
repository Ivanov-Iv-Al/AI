import numpy as np
import matplotlib.pyplot as plt

# ======================== ГРАФИК 1: СИГНАЛЬНОЕ СОЗВЕЗДИЕ QPSK ========================

def plot_constellation(tx_symbols, rx_symbols):
    """Сигнальное созвездие QPSK в передатчике и приёмнике"""
    plt.figure(figsize=(12, 5))
    
    # Созвездие переданных символов
    plt.subplot(1, 2, 1)
    plt.scatter([s.real for s in tx_symbols], [s.imag for s in tx_symbols], 
                s=20, alpha=0.7, c='blue')
    plt.axhline(y=0, color='k', linewidth=0.5)
    plt.axvline(x=0, color='k', linewidth=0.5)
    plt.grid(True, alpha=0.3)
    plt.title('Созвездие QPSK в передатчике')
    plt.xlabel('I (синфазная компонента)')
    plt.ylabel('Q (квадратурная компонента)')
    plt.axis('equal')
    plt.xlim(-1.5, 1.5)
    plt.ylim(-1.5, 1.5)
    
    # Созвездие принятых символов
    plt.subplot(1, 2, 2)
    plt.scatter([s.real for s in rx_symbols], [s.imag for s in rx_symbols], 
                s=20, alpha=0.7, c='red')
    plt.axhline(y=0, color='k', linewidth=0.5)
    plt.axvline(x=0, color='k', linewidth=0.5)
    plt.grid(True, alpha=0.3)
    plt.title('Созвездие QPSK в приёмнике')
    plt.xlabel('I (синфазная компонента)')
    plt.ylabel('Q (квадратурная компонента)')
    plt.axis('equal')
    plt.xlim(-1.5, 1.5)
    plt.ylim(-1.5, 1.5)
    
    plt.tight_layout()
    plt.show()


# ======================== ГРАФИК 2: СПЕКТР OFDM СИМВОЛА ========================

def plot_spectrum(tx_spectrum, rx_spectrum_before, rx_spectrum_after):
    """Спектр OFDM символа до и после эквалайзинга"""
    plt.figure(figsize=(12, 10))
    
    # Спектр переданного сигнала
    plt.subplot(3, 1, 1)
    plt.plot(np.abs(tx_spectrum), 'b-', linewidth=1.5)
    plt.title('Спектр переданного OFDM символа')
    plt.xlabel('Индекс поднесущей')
    plt.ylabel('Амплитуда')
    plt.grid(True, alpha=0.3)
    plt.xlim(0, len(tx_spectrum)-1)
    
    # Спектр принятого сигнала ДО эквалайзинга
    plt.subplot(3, 1, 2)
    plt.plot(np.abs(rx_spectrum_before), 'r-', linewidth=1.5)
    plt.title('Спектр принятого OFDM символа (до эквалайзинга)')
    plt.xlabel('Индекс поднесущей')
    plt.ylabel('Амплитуда')
    plt.grid(True, alpha=0.3)
    plt.xlim(0, len(rx_spectrum_before)-1)
    
    # Спектр принятого сигнала ПОСЛЕ эквалайзинга
    plt.subplot(3, 1, 3)
    plt.plot(np.abs(rx_spectrum_after), 'g-', linewidth=1.5)
    plt.title('Спектр принятого OFDM символа (после эквалайзинга)')
    plt.xlabel('Индекс поднесущей')
    plt.ylabel('Амплитуда')
    plt.grid(True, alpha=0.3)
    plt.xlim(0, len(rx_spectrum_after)-1)
    
    plt.tight_layout()
    plt.show()


# ======================== ГРАФИК 3: BER vs SNR ========================

def plot_ber_curve(snr_values, ber_values):
    """Зависимость BER от SNR"""
    plt.figure(figsize=(10, 6))
    
    # Логарифмическая шкала по Y для BER
    plt.semilogy(snr_values, ber_values, 'bo-', linewidth=2, markersize=8)
    
    plt.title('Зависимость вероятности битовой ошибки (BER) от отношения сигнал/шум (SNR)', fontsize=14)
    plt.xlabel('SNR (дБ)', fontsize=12)
    plt.ylabel('BER (Bit Error Rate)', fontsize=12)
    plt.grid(True, linestyle='--', alpha=0.6)
    plt.ylim(1e-6, 1)
    plt.xlim(min(snr_values)-1, max(snr_values)+1)
    
    plt.tight_layout()
    plt.show()


# ======================== ГРАФИК 4: ОЦЕНКА КАНАЛА (АЧХ) ========================

def plot_channel_response(frequencies, h_est, title="АЧХ канала передачи"):
    """Оценка частотной характеристики канала"""
    plt.figure(figsize=(10, 6))
    
    # Амплитудная характеристика
    plt.subplot(2, 1, 1)
    plt.plot(frequencies, np.abs(h_est), 'b-', linewidth=1.5)
    plt.stem(frequencies[::8], np.abs(h_est)[::8], 'r-', markerfmt='ro', linefmt='r--')
    plt.title('Амплитудная характеристика канала (|H|)')
    plt.ylabel('|H|')
    plt.grid(True, alpha=0.3)
    plt.legend(['Интерполированная АЧХ', 'Оценка по пилотам'])
    
    # Фазовая характеристика
    plt.subplot(2, 1, 2)
    plt.plot(frequencies, np.angle(h_est) * 180 / np.pi, 'b-', linewidth=1.5)
    plt.stem(frequencies[::8], np.angle(h_est)[::8] * 180 / np.pi, 'r-', markerfmt='ro', linefmt='r--')
    plt.title('Фазовая характеристика канала (∠H, градусы)')
    plt.xlabel('Индекс поднесущей')
    plt.ylabel('Фаза (градусы)')
    plt.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.show()


# ======================== ГРАФИК 5: ВРЕМЕННАЯ ФОРМА OFDM СИГНАЛА ========================

def plot_time_signal(tx_signal, rx_signal, sample_range=200):
    """Временная форма OFDM сигнала"""
    plt.figure(figsize=(12, 8))
    
    # Переданный сигнал
    plt.subplot(2, 1, 1)
    time_axis = np.arange(min(sample_range, len(tx_signal)))
    plt.plot(time_axis, tx_signal.real[:sample_range], 'b-', label='I (синфазная)', alpha=0.7)
    plt.plot(time_axis, tx_signal.imag[:sample_range], 'r-', label='Q (квадратурная)', alpha=0.7)
    plt.title('Временная форма переданного OFDM сигнала')
    plt.xlabel('Отсчёт')
    plt.ylabel('Амплитуда')
    plt.legend()
    plt.grid(True, alpha=0.3)
    
    # Принятый сигнал
    plt.subplot(2, 1, 2)
    plt.plot(time_axis, rx_signal.real[:sample_range], 'b-', label='I (синфазная)', alpha=0.7)
    plt.plot(time_axis, rx_signal.imag[:sample_range], 'r-', label='Q (квадратурная)', alpha=0.7)
    plt.title('Временная форма принятого OFDM сигнала (с искажениями)')
    plt.xlabel('Отсчёт')
    plt.ylabel('Амплитуда')
    plt.legend()
    plt.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.show()


# ======================== ГРАФИК 6: СРАВНЕНИЕ СПЕКТРОВ НА ОДНОМ ГРАФИКЕ ========================

def plot_spectrum_comparison(tx_spectrum, rx_spectrum_before, rx_spectrum_after):
    """Сравнение спектров на одном графике"""
    plt.figure(figsize=(12, 6))
    
    frequencies = np.arange(len(tx_spectrum))
    
    plt.plot(frequencies, np.abs(tx_spectrum), 'b-', linewidth=1.5, label='Переданный сигнал', alpha=0.8)
    plt.plot(frequencies, np.abs(rx_spectrum_before), 'r-', linewidth=1.0, label='Принятый сигнал (до экв.)', alpha=0.6)
    plt.plot(frequencies, np.abs(rx_spectrum_after), 'g-', linewidth=1.5, label='Принятый сигнал (после экв.)', alpha=0.8)
    
    # Отметить пилот-тоны
    pilot_indices = np.arange(0, len(tx_spectrum), 8)
    plt.stem(pilot_indices, np.abs(tx_spectrum)[pilot_indices], 'k-', 
             markerfmt='ks', linefmt='k--', label='Пилот-тоны', alpha=0.5)
    
    plt.title('Сравнение спектров OFDM сигнала')
    plt.xlabel('Индекс поднесущей')
    plt.ylabel('Амплитуда')
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.xlim(0, len(tx_spectrum)-1)
    
    plt.tight_layout()
    plt.show()


# ======================== ГРАФИК 7: ГИСТОГРАММА ОШИБОК ========================

def plot_error_histogram(error_positions, total_bits):
    """Гистограмма распределения ошибок по битам"""
    plt.figure(figsize=(12, 5))
    
    # Гистограмма ошибок
    bins = 20
    plt.hist(error_positions, bins=bins, edgecolor='black', alpha=0.7, color='red')
    
    plt.title(f'Распределение битовых ошибок (всего ошибок: {len(error_positions)} из {total_bits} бит)')
    plt.xlabel('Позиция бита')
    plt.ylabel('Количество ошибок')
    plt.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.show()


# ======================== ГРАФИК 8: ВСЕ ГРАФИКИ В ОДНОМ ОКНЕ ========================

def plot_all_in_one(tx_symbols, rx_symbols, tx_spectrum, rx_spectrum_before, 
                    rx_spectrum_after, snr_values, ber_values):
    """Все графики в одном окне"""
    fig = plt.figure(figsize=(16, 12))
    
    # 1. Созвездие QPSK
    ax1 = plt.subplot(2, 3, 1)
    ax1.scatter([s.real for s in tx_symbols[:500]], [s.imag for s in tx_symbols[:500]], 
                s=10, alpha=0.5, c='blue')
    ax1.set_title('Созвездие передатчика')
    ax1.set_xlabel('I')
    ax1.set_ylabel('Q')
    ax1.grid(True, alpha=0.3)
    ax1.axis('equal')
    
    ax2 = plt.subplot(2, 3, 2)
    ax2.scatter([s.real for s in rx_symbols[:500]], [s.imag for s in rx_symbols[:500]], 
                s=10, alpha=0.5, c='red')
    ax2.set_title('Созвездие приёмника')
    ax2.set_xlabel('I')
    ax2.set_ylabel('Q')
    ax2.grid(True, alpha=0.3)
    ax2.axis('equal')
    
    # 2. Спектры
    ax3 = plt.subplot(2, 3, 3)
    ax3.plot(np.abs(tx_spectrum), 'b-', label='Переданный', alpha=0.7)
    ax3.plot(np.abs(rx_spectrum_before), 'r-', label='Принятый (до)', alpha=0.5)
    ax3.plot(np.abs(rx_spectrum_after), 'g-', label='Принятый (после)', alpha=0.7)
    ax3.set_title('Спектры OFDM сигнала')
    ax3.set_xlabel('Поднесущая')
    ax3.set_ylabel('Амплитуда')
    ax3.legend(fontsize=8)
    ax3.grid(True, alpha=0.3)
    
    # 3. BER vs SNR
    ax4 = plt.subplot(2, 3, 4)
    ax4.semilogy(snr_values, ber_values, 'bo-', linewidth=1.5, markersize=4)
    ax4.set_title('BER vs SNR')
    ax4.set_xlabel('SNR (дБ)')
    ax4.set_ylabel('BER')
    ax4.grid(True, alpha=0.3)
    
    # 4. АЧХ канала
    ax5 = plt.subplot(2, 3, 5)
    h_est = np.abs(rx_spectrum_before) / (np.abs(tx_spectrum) + 1e-10)
    ax5.plot(h_est, 'purple', linewidth=1.5)
    ax5.set_title('АЧХ канала')
    ax5.set_xlabel('Поднесущая')
    ax5.set_ylabel('|H|')
    ax5.grid(True, alpha=0.3)
    
    # 5. Информация о BER
    ax6 = plt.subplot(2, 3, 6)
    ax6.axis('off')
    final_ber = ber_values[-1] if ber_values else 0
    ax6.text(0.1, 0.7, f'Финальный BER: {final_ber:.2e}', fontsize=12, fontweight='bold')
    ax6.text(0.1, 0.5, f'SNR макс: {max(snr_values)} дБ', fontsize=12)
    ax6.text(0.1, 0.3, f'Поднесущих: {len(tx_spectrum)}', fontsize=12)
    ax6.text(0.1, 0.1, f'CP длина: 16', fontsize=12)
    
    plt.suptitle('Анализ OFDM системы связи', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.show()


# ======================== ПРИМЕР ИСПОЛЬЗОВАНИЯ ========================

if __name__ == "__main__":
    # Пример данных (замените на свои реальные данные)
    
    # 1. Созвездия
    tx_qpsk = np.array([0.707+0.707j, 0.707-0.707j, -0.707+0.707j, -0.707-0.707j]) * 100
    rx_qpsk = tx_qpsk + np.random.randn(100) * 0.3 + 1j * np.random.randn(100) * 0.3
    
    # 2. Спектры
    tx_spec = np.abs(np.random.randn(64) + 1j * np.random.randn(64))
    tx_spec[::8] = 1.0  # пилоты
    rx_spec_before = tx_spec * (0.5 + 0.3j) + np.random.randn(64) * 0.1
    rx_spec_after = rx_spec_before / (0.5 + 0.3j)
    
    # 3. BER данные
    snr_db = [-10, -5, 0, 5, 10, 15, 20, 25]
    ber = [0.5, 0.2, 0.05, 0.01, 0.001, 0.0001, 1e-5, 1e-6]
    
    # Вызов функций
    plot_constellation(tx_qpsk, rx_qpsk)
    plot_spectrum(tx_spec, rx_spec_before, rx_spec_after)
    plot_ber_curve(snr_db, ber)
    plot_channel_response(np.arange(64), rx_spec_before / (tx_spec + 1e-10))
    plot_spectrum_comparison(tx_spec, rx_spec_before, rx_spec_after)
    plot_all_in_one(tx_qpsk, rx_qpsk, tx_spec, rx_spec_before, rx_spec_after, snr_db, ber)
